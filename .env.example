# Environment variables (create .env.local with actual values)
# This file is for development/testing reference only

# API Configuration
DEBUG=true
LOG_LEVEL=INFO

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./fraud.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ccrd

# Security (MUST CHANGE IN PRODUCTION - use at least 32 random characters)
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings (allow frontend during development)
FRONTEND_URL=http://localhost:3000

# ML Models paths
MODEL_PATH=backend/ml/models/model.pkl
SCALER_PATH=backend/ml/models/scaler.pkl

# Feature flags
ENABLE_OTP=true
ENABLE_TRANSLATIONS=false

# Logging
LOG_FILE=logs/app.log
