# Vercel Environment Variables for CCRD

# Backend API Configuration
NEXT_PUBLIC_API_URL=https://your-backend-domain.com

# Database (if deploying backend to Vercel)
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Configuration  
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-prod

# CORS Configuration
FRONTEND_URL=https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-domain.com

# Logging
LOG_LEVEL=INFO
DEBUG=false

# ML Model Path
MODEL_PATH=/tmp/fraud_model.pkl

# Authentication
TOKEN_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Feature Flags
ENABLE_SWAGGER_DOCS=true
ENABLE_REDOC=true
