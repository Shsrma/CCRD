# API Configuration
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./fraud.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/ccrd

# Security (CHANGE IN PRODUCTION)
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
FRONTEND_URL=http://localhost:3000

# ML Models
MODEL_PATH=backend/ml/models/model.pkl
SCALER_PATH=backend/ml/models/scaler.pkl

# Features
ENABLE_OTP=true
ENABLE_TRANSLATIONS=false
